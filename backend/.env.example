# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Railway provides DATABASE_URL automatically. Leave unset locally to use SQLite.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Comma-separated origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Where new inquiries are emailed (optional).
INQUIRY_NOTIFY_EMAIL=registry@arbitration.uz

# --- Telegram (signal only — the bot is never sent inquiry content) --------
# From @BotFather. Leave empty to disable notifications entirely.
TELEGRAM_BOT_TOKEN=
# Chat or group id the signals go to (a group id starts with -100...).
TELEGRAM_CHAT_ID=
# Absolute base URL of this backend, used to build the "open in admin" link.
# On Railway this is filled in automatically from RAILWAY_PUBLIC_DOMAIN —
# only set it if the admin is reached through a custom domain instead.
SITE_ADMIN_URL=
